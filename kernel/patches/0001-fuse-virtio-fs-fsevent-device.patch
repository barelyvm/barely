From: Louis Laugesen <louis@lgsn.dev>
Subject: [PATCH] fuse: virtio-fs: device for host-driven file-change events

Apple's virtio-fs server never sends FUSE notifications, so when a file
changes on the host the guest's dcache, attributes and page cache go stale
and inotify watchers in the guest never fire.

Add CONFIG_VIRTIO_FS_FSEVENT and a write-only misc device,
/dev/barely-fsevent. A guest agent that learns about host changes writes
them to it, one record per line: "<op> <absolute path>\n", where op is M
(contents changed), C (created) or D (deleted). A rename arrives as D of
the old path and C of the new one. For each record the kernel invalidates
what the guest has cached for that path and raises the fsnotify event a
local write would have produced.

A change the guest made itself comes back as a record too. M raises
nothing when the guest's own write is still pending an attribute refresh,
or when the refreshed size and mtime match what the guest already had. C
of a name the guest already has cached is looked up again: the same inode
is treated as M, and a new inode (an atomic save) raises create and
modify.

Paths are resolved from the dcache only. If the guest has never looked a
path up, nothing can be watching it and there is nothing to invalidate.
The exception is a child of a watched directory, which is looked up on
demand.
---
diff -urN pa/fs/fuse/Kconfig pb/fs/fuse/Kconfig
--- a/fs/fuse/Kconfig	2026-10-08 14:41:02.235220008 +0000
+++ b/fs/fuse/Kconfig	2026-10-08 14:41:02.241220008 +0000
@@ -76,3 +76,13 @@
 
 	  If you want to allow fuse server/client communication through io-uring,
 	  answer Y
+
+config VIRTIO_FS_FSEVENT
+	bool "Host-driven file-change events for virtio-fs"
+	depends on VIRTIO_FS=y && FUSE_FS=y
+	help
+	  Adds a misc device that a guest agent writes host file-change
+	  records to. For each path the guest has cached, virtio-fs's cached
+	  dentries, attributes and page cache are invalidated and the matching
+	  fsnotify event is raised, so inotify watchers in the guest see edits
+	  made on the host.
diff -urN pa/fs/fuse/Makefile pb/fs/fuse/Makefile
--- a/fs/fuse/Makefile	2026-10-08 14:41:02.235220008 +0000
+++ b/fs/fuse/Makefile	2026-10-08 14:41:02.244220008 +0000
@@ -13,6 +13,7 @@
 fuse-y := trace.o	# put trace.o first so we see ftrace errors sooner
 fuse-y += dev.o dir.o file.o inode.o control.o xattr.o acl.o readdir.o ioctl.o
 fuse-y += iomode.o
+fuse-$(CONFIG_VIRTIO_FS_FSEVENT) += fsevent.o
 fuse-$(CONFIG_FUSE_DAX) += dax.o
 fuse-$(CONFIG_FUSE_PASSTHROUGH) += passthrough.o backing.o
 fuse-$(CONFIG_SYSCTL) += sysctl.o
diff -urN pa/fs/fuse/fsevent.c pb/fs/fuse/fsevent.c
--- a/fs/fuse/fsevent.c	1970-01-01 00:00:00.000000000 +0000
+++ b/fs/fuse/fsevent.c	2026-10-08 14:41:02.239220008 +0000
@@ -0,0 +1,471 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Host-driven file-change events for virtio-fs.
+ *
+ * Apple's virtio-fs server never sends FUSE notifications, so the guest's
+ * dcache, attributes and page cache go stale when files change on the host and
+ * inotify watchers never fire. A guest agent that learns about host changes
+ * writes them here; we invalidate what the guest has cached and raise the
+ * fsnotify event a local write would have produced.
+ *
+ * Format, one record per line: "<op> <absolute path>\n"
+ *   M  contents changed       C  created       D  deleted
+ * The agent batches many records into one write. A rename arrives as D of
+ * the old path and C of the new one.
+ *
+ * Echoes: a change the guest made itself also shows up on the host and
+ * comes back here. A local write marks the inode's cached mtime stale
+ * (fuse_inode.inval_mask) until the next attribute refresh, while a host
+ * change only ever expires the cache by timeout; so M refreshes but raises
+ * nothing when the guest's own write is still pending a refresh, or when
+ * the refreshed size and mtime match what the guest already had. C of a
+ * name the guest already has cached is looked up again: the same inode is
+ * treated as M, a new inode (an atomic save) raises create and modify.
+ *
+ * Paths are resolved from the dcache only: if the guest has never looked a
+ * path up, nothing can be watching it and there is nothing to invalidate. The
+ * exception is a child of a watched directory, which is looked up on demand.
+ */
+
+#include <linux/fs.h>
+#include <linux/fs_struct.h>
+#include <linux/fsnotify.h>
+#include <linux/miscdevice.h>
+#include <linux/namei.h>
+#include <linux/slab.h>
+#include <linux/stat.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "fuse_i.h"
+
+#define FSEVENT_MAX_WRITE (64 * 1024)
+
+static bool is_virtiofs(struct super_block *sb)
+{
+	return strcmp(sb->s_type->name, "virtiofs") == 0;
+}
+
+/*
+ * Resolves an absolute, canonical path using d_lookup only. Unlike kern_path,
+ * this never revalidates (which would hit the server, or with LOOKUP_CACHED
+ * fail once FUSE's entry timeout has expired) and never silently drops a
+ * stale dentry we are about to report on.
+ */
+static int lookup_cached(const char *pathname, struct path *out)
+{
+	struct path cur;
+	const char *p = pathname;
+
+	if (*p != '/') {
+		return -EINVAL;
+	}
+	get_fs_root(current->fs, &cur);
+	while (d_mountpoint(cur.dentry) && follow_down_one(&cur)) {
+	}
+
+	for (;;) {
+		const char *end;
+		struct qstr name;
+		struct dentry *child;
+
+		while (*p == '/') {
+			p++;
+		}
+		if (*p == '\0') {
+			break;
+		}
+		end = strchrnul(p, '/');
+		name = (struct qstr)QSTR_INIT(p, end - p);
+		if ((name.len == 1 && p[0] == '.') ||
+		    (name.len == 2 && p[0] == '.' && p[1] == '.')) {
+			path_put(&cur);
+			return -EINVAL;
+		}
+		name.hash = full_name_hash(cur.dentry, name.name, name.len);
+		child = d_lookup(cur.dentry, &name);
+		if (!child || d_really_is_negative(child)) {
+			dput(child);
+			path_put(&cur);
+			return -ENOENT;
+		}
+		dput(cur.dentry);
+		cur.dentry = child;
+		while (d_mountpoint(cur.dentry) && follow_down_one(&cur)) {
+		}
+		p = end;
+	}
+	*out = cur;
+	return 0;
+}
+
+static void log_attrs(const char *what, const char *path, struct inode *inode)
+{
+	struct timespec64 mt = inode_get_mtime(inode);
+
+	pr_debug("fsevent: %s %s size=%lld mtime=%lld.%09ld\n", what, path,
+		i_size_read(inode), mt.tv_sec, mt.tv_nsec);
+}
+
+/* Refreshes attributes now so later readers see the host's size and mtime. */
+static void refetch_attrs(const struct path *path)
+{
+	struct kstat st;
+
+	vfs_getattr(path, &st, STATX_BASIC_STATS, AT_STATX_FORCE_SYNC);
+}
+
+static int inval_inode(struct inode *inode)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+	int err;
+
+	down_read(&fc->killsb);
+	err = fuse_reverse_inval_inode(fc, get_node_id(inode), 0, 0);
+	up_read(&fc->killsb);
+	return err;
+}
+
+/* Splits an absolute path into its parent and final component. */
+static int split_path(char *pathname, char **parent, struct qstr *name)
+{
+	char *slash = strrchr(pathname, '/');
+
+	if (!slash || slash[1] == '\0' || slash == pathname) {
+		return -EINVAL;
+	}
+	*slash = '\0';
+	*parent = pathname;
+	*name = (struct qstr)QSTR_INIT(slash + 1, strlen(slash + 1));
+	return 0;
+}
+
+static int lookup_parent(const char *parent, struct path *path)
+{
+	int err = lookup_cached(parent, path);
+
+	if (err) {
+		return err;
+	}
+	if (!d_is_dir(path->dentry) || !is_virtiofs(path->dentry->d_sb)) {
+		path_put(path);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+/*
+ * A file the guest never looked up can still matter: a watched directory gets
+ * events for all its children. Ask the server for it in that case only.
+ */
+static int lookup_watched_child(char *pathname, struct path *out)
+{
+	struct path parent;
+	struct dentry *child;
+	char *parent_name;
+	struct qstr name;
+	int err;
+
+	err = split_path(pathname, &parent_name, &name);
+	if (err) {
+		return err;
+	}
+	err = lookup_parent(parent_name, &parent);
+	if (err) {
+		goto restore;
+	}
+	if (!fsnotify_inode_watches_children(d_inode(parent.dentry))) {
+		err = -ENOENT;
+		goto out;
+	}
+	child = lookup_noperm_unlocked(&name, parent.dentry);
+	if (IS_ERR(child)) {
+		err = PTR_ERR(child);
+		goto out;
+	}
+	if (d_really_is_negative(child)) {
+		dput(child);
+		err = -ENOENT;
+		goto out;
+	}
+	out->mnt = mntget(parent.mnt);
+	out->dentry = child;
+out:
+	path_put(&parent);
+restore:
+	pathname[strlen(pathname)] = '/';
+	return err;
+}
+
+static int fsevent_modify(char *pathname)
+{
+	struct path path;
+	struct inode *inode;
+	struct timespec64 before_mtime, after_mtime;
+	loff_t before_size;
+	bool local_write;
+	int err;
+
+	err = lookup_cached(pathname, &path);
+	if (err == -ENOENT) {
+		err = lookup_watched_child(pathname, &path);
+	}
+	if (err) {
+		return err;
+	}
+	if (!is_virtiofs(path.dentry->d_sb)) {
+		err = -EINVAL;
+		goto out;
+	}
+	inode = d_inode(path.dentry);
+	local_write = READ_ONCE(get_fuse_inode(inode)->inval_mask) & STATX_MTIME;
+	before_size = i_size_read(inode);
+	before_mtime = inode_get_mtime(inode);
+	log_attrs("modify before", pathname, inode);
+
+	err = inval_inode(inode);
+	if (err) {
+		goto out;
+	}
+	refetch_attrs(&path);
+	log_attrs("modify after", pathname, inode);
+
+	after_mtime = inode_get_mtime(inode);
+	if (!S_ISDIR(inode->i_mode) &&
+	    (local_write || (i_size_read(inode) == before_size &&
+			     timespec64_equal(&after_mtime, &before_mtime)))) {
+		goto out; /* nothing the guest didn't already see: an echo */
+	}
+	fsnotify_dentry(path.dentry, FS_MODIFY);
+	if (!S_ISDIR(inode->i_mode)) {
+		fsnotify_dentry(path.dentry, FS_CLOSE_WRITE);
+	}
+out:
+	path_put(&path);
+	return err;
+}
+
+static int fsevent_create(char *pathname)
+{
+	struct path parent;
+	struct inode *dir;
+	struct fuse_conn *fc;
+	struct dentry *child;
+	char *parent_name;
+	struct qstr name;
+	int err;
+
+	err = split_path(pathname, &parent_name, &name);
+	if (err) {
+		return err;
+	}
+	err = lookup_parent(parent_name, &parent);
+	if (err) {
+		return err;
+	}
+	dir = d_inode(parent.dentry);
+	fc = get_fuse_conn(dir);
+
+	/*
+	 * Already cached. Either the guest made it itself (or heard about it
+	 * already), or the host replaced the file: an atomic save writes a new
+	 * file and renames it over the old one, leaving the cached dentry on the
+	 * old inode. Look the name up again; the same inode means an in-place
+	 * change (handled like M), a new one means a replacement (an event).
+	 */
+	name.hash = full_name_hash(parent.dentry, name.name, name.len);
+	child = d_lookup(parent.dentry, &name);
+	if (child && d_really_is_positive(child)) {
+		/* The host's inode number survives a re-lookup; the FUSE node id may not. */
+		unsigned long old_ino = d_inode(child)->i_ino;
+		/* Read before the lookup below refreshes the attributes. */
+		bool local_write = READ_ONCE(get_fuse_inode(d_inode(child))->inval_mask) & STATX_MTIME;
+		loff_t old_size = i_size_read(d_inode(child));
+		struct timespec64 old_mtime = inode_get_mtime(d_inode(child));
+		struct timespec64 new_mtime;
+
+		dput(child);
+		down_read(&fc->killsb);
+		fuse_reverse_inval_entry(fc, get_node_id(dir), 0, &name, 0);
+		up_read(&fc->killsb);
+		child = lookup_noperm_unlocked(&name, parent.dentry);
+		if (IS_ERR(child)) {
+			err = PTR_ERR(child);
+			goto out;
+		}
+		if (d_really_is_positive(child) && d_inode(child)->i_ino == old_ino) {
+			/* In place: an event only if the host's attributes moved on. */
+			new_mtime = inode_get_mtime(d_inode(child));
+			if (!local_write && !d_is_dir(child) &&
+			    (i_size_read(d_inode(child)) != old_size ||
+			     !timespec64_equal(&new_mtime, &old_mtime))) {
+				fsnotify_dentry(child, FS_MODIFY);
+				fsnotify_dentry(child, FS_CLOSE_WRITE);
+			}
+			dput(child);
+			goto out;
+		}
+		if (d_really_is_negative(child)) {
+			err = -ENOENT;
+		} else {
+			inval_inode(dir);
+			fsnotify_create(dir, child);
+			fsnotify_dentry(child, FS_MODIFY);
+			fsnotify_dentry(child, FS_CLOSE_WRITE);
+		}
+		dput(child);
+		goto out;
+	}
+	dput(child);
+
+	/* Drop a cached negative dentry, then the directory's attrs and readdir cache. */
+	down_read(&fc->killsb);
+	fuse_reverse_inval_entry(fc, get_node_id(dir), 0, &name, 0);
+	up_read(&fc->killsb);
+	err = inval_inode(dir);
+	if (err) {
+		goto out;
+	}
+
+	child = lookup_noperm_unlocked(&name, parent.dentry);
+	if (IS_ERR(child)) {
+		err = PTR_ERR(child);
+		goto out;
+	}
+	if (d_really_is_negative(child)) {
+		pr_debug("fsevent: create %s/%s: not on host\n", parent_name, name.name);
+		err = -ENOENT;
+	} else if (d_is_dir(child)) {
+		fsnotify_mkdir(dir, child);
+	} else {
+		fsnotify_create(dir, child);
+		fsnotify_dentry(child, FS_CLOSE_WRITE);
+	}
+	dput(child);
+out:
+	path_put(&parent);
+	return err;
+}
+
+static int fsevent_delete(char *pathname)
+{
+	struct path parent;
+	struct inode *dir;
+	struct inode *inode;
+	struct fuse_conn *fc;
+	struct dentry *child;
+	char *parent_name;
+	struct qstr name;
+	int err;
+
+	err = split_path(pathname, &parent_name, &name);
+	if (err) {
+		return err;
+	}
+	err = lookup_parent(parent_name, &parent);
+	if (err) {
+		return err;
+	}
+	dir = d_inode(parent.dentry);
+	fc = get_fuse_conn(dir);
+
+	/* d_lookup, not lookup_noperm: revalidation would drop the dentry silently. */
+	name.hash = full_name_hash(parent.dentry, name.name, name.len);
+	child = d_lookup(parent.dentry, &name);
+	if (!child) {
+		err = -ENOENT;
+		goto out;
+	}
+	if (d_really_is_negative(child)) {
+		err = -ENOENT;
+		goto out_child;
+	}
+	inode = d_inode(child);
+	ihold(inode);
+
+	down_read(&fc->killsb);
+	err = fuse_reverse_inval_entry(fc, get_node_id(dir), get_node_id(inode),
+				       &name, 0);
+	up_read(&fc->killsb);
+	if (!err) {
+		fsnotify_delete(dir, inode, child);
+	}
+	iput(inode);
+out_child:
+	dput(child);
+out:
+	path_put(&parent);
+	return err;
+}
+
+static int fsevent_apply(char op, char *pathname)
+{
+	if (pathname[0] != '/') {
+		return -EINVAL;
+	}
+	switch (op) {
+	case 'M':
+		return fsevent_modify(pathname);
+	case 'C':
+		return fsevent_create(pathname);
+	case 'D':
+		return fsevent_delete(pathname);
+	default:
+		return -EINVAL;
+	}
+}
+
+static ssize_t fsevent_write(struct file *file, const char __user *ubuf,
+			     size_t len, loff_t *ppos)
+{
+	char *buf;
+	char *line;
+	char *cur;
+
+	if (!capable(CAP_SYS_ADMIN)) {
+		return -EPERM;
+	}
+	if (len > FSEVENT_MAX_WRITE) {
+		return -E2BIG;
+	}
+	buf = memdup_user_nul(ubuf, len);
+	if (IS_ERR(buf)) {
+		return PTR_ERR(buf);
+	}
+
+	cur = buf;
+	while ((line = strsep(&cur, "\n")) != NULL) {
+		int err;
+
+		if (line[0] == '\0') {
+			continue;
+		}
+		if (line[1] != ' ') {
+			pr_warn_ratelimited("fsevent: bad record '%s'\n", line);
+			continue;
+		}
+		err = fsevent_apply(line[0], line + 2);
+		pr_debug("fsevent: %s: %d\n", line, err);
+	}
+	kfree(buf);
+	return len;
+}
+
+static const struct file_operations fsevent_fops = {
+	.owner = THIS_MODULE,
+	.write = fsevent_write,
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice fsevent_dev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "barely-fsevent",
+	.fops = &fsevent_fops,
+	.mode = 0200,
+};
+
+static int __init fsevent_init(void)
+{
+	return misc_register(&fsevent_dev);
+}
+late_initcall(fsevent_init);

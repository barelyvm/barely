# Generated by `make formula` from packaging/homebrew/barely.rb.in.
class Barely < Formula
  desc "Docker host VM with elastic memory and storage"
  homepage "https://github.com/barelyvm/barely"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@"
  # barely itself is Apache-2.0; the guest image carries a Linux kernel.
  license all_of: ["Apache-2.0", "GPL-2.0-only"]

  depends_on arch: :arm64
  depends_on "docker"
  depends_on "docker-buildx"
  depends_on "docker-compose"
  depends_on macos: :sonoma

  def install
    bin.install "bin/barely"
    libexec.install Dir["libexec/*"]
    (share/"barely").install "share/barely/guest"

    # Only barelyvm uses Apple's Hypervisor framework. An ad-hoc signature
    # made here, on the Mac it runs on, carries the entitlement it needs; no
    # Apple developer account is involved.
    system "codesign", "--sign", "-", "--force", libexec/"libkrun.1.dylib"
    system "codesign", "--sign", "-", "--force",
           "--entitlements", libexec/"barely.entitlements", libexec/"barelyvm"
  end

  def caveats
    <<~EOS
      Finish the install with:
        barely setup
      It says what each step changes (launchd agent, Docker context,
      /var/run/docker.sock symlink) and asks at each choice.
    EOS
  end

  test do
    assert_match "barely #{version}", shell_output("#{bin}/barely version")
    assert_match "com.apple.security.hypervisor",
                 shell_output("codesign -d --entitlements - #{libexec}/barelyvm 2>&1")
  end
end
